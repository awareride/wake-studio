{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wake-studio.dev/module-spec.schema.json",
  "title": "WakeStudio ModuleSpec",
  "description": "Declarative contract for a WakeStudio module (ADR-025). Consumed by the panel generator, playground router, test runner, studio-backend route registry, and the generic build/train workflows.",
  "type": "object",
  "required": [
    "meta",
    "params",
    "actions",
    "status",
    "runtime",
    "tests",
    "playground",
    "interfaces"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "version",
        "maturity",
        "owner",
        "license",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Unique kebab-case id (not necessarily the directory basename; e.g. kws-openwakeword)."
        },
        "name": {
          "type": "string"
        },
        "category": {
          "enum": [
            "afe",
            "kws",
            "few-shot",
            "training",
            "data",
            "export",
            "platform"
          ]
        },
        "version": {
          "type": "string"
        },
        "maturity": {
          "enum": [
            "draft",
            "pilot",
            "stable",
            "deprecated"
          ]
        },
        "owner": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "released"
          ]
        }
      }
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "group",
          "type",
          "default"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "group": {
            "enum": [
              "primary",
              "advanced"
            ]
          },
          "type": {
            "enum": [
              "number",
              "boolean",
              "select",
              "enum",
              "slider",
              "secret",
              "string"
            ]
          },
          "default": {},
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "description": "Allowed values for select/enum params. Either a plain string (value used as its own label) or an explicit {value,label} pair. Renderers must accept both (see normalizeSelectOptions in @wake-studio/module-kit).",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "validation": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "if": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "load",
              "start",
              "stop",
              "export",
              "train",
              "record",
              "reset",
              "enroll"
            ]
          },
          "confirm": {
            "type": "boolean"
          },
          "progress": {
            "enum": [
              "none",
              "determinate",
              "indeterminate"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "status": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "renderer",
          "source",
          "refreshMs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "renderer": {
            "enum": [
              "bar",
              "waveform",
              "badge",
              "gauge",
              "text",
              "curve"
            ]
          },
          "source": {
            "type": "string"
          },
          "refreshMs": {
            "type": "number"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "web"
      ],
      "properties": {
        "web": {
          "type": "object",
          "required": [
            "engine"
          ],
          "properties": {
            "engine": {
              "type": "string"
            },
            "wasm": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "loader": {
                  "enum": [
                    "classic",
                    "emscripten",
                    "onnx"
                  ]
                }
              }
            },
            "worker": {
              "type": "boolean"
            }
          }
        },
        "local": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "protocol": {
              "enum": [
                "stdio",
                "http"
              ]
            }
          }
        },
        "cloud": {
          "type": "object",
          "properties": {
            "workflowRef": {
              "type": "string"
            },
            "artifact": {
              "type": "string"
            }
          }
        },
        "device": {
          "type": "object",
          "properties": {
            "sdkModule": {
              "type": "string"
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "train": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string"
        },
        "notebookLocal": {
          "type": "string",
          "description": "Repo-relative path to the module-owned Colab notebook (e.g. \"packages/modules/kws/openwakeword/train/colab/train.ipynb\"). Distinct from \"notebook\" (upstream ref): the notebook lives in this repo and the generated panel renders an \"Open in Colab\" action from it (ADR-035). Repo-relative to match playground.entry / tests paths."
        },
        "python": {
          "type": "string"
        },
        "deps": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "description": "Train params declared by the module itself (issue #105) - the wizard's Configure step renders these spec-driven, so each module owns its own train config (a wake phrase + steps for openwakeword, feature type / training steps for kws_streaming, none for frozen-weight rnnoise). Same shape as the top-level params array.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "group",
              "type",
              "default"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "group": {
                "enum": [
                  "primary",
                  "advanced"
                ]
              },
              "type": {
                "enum": [
                  "number",
                  "boolean",
                  "select",
                  "enum",
                  "slider",
                  "secret",
                  "string"
                ]
              },
              "default": {},
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "value"
                      ],
                      "properties": {
                        "value": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "validation": {
                "type": "object",
                "properties": {
                  "required": {
                    "type": "boolean"
                  },
                  "if": {
                    "type": "string"
                  }
                }
              },
              "env": {
                "type": "string",
                "description": "Notebook env var this train param maps to (issue #105) \u2014 the app bakes the user's value into the downloaded notebook by replacing the default in os.environ.get(\"ENV\", \"default\")."
              }
            }
          }
        },
        "invocation": {
          "type": "array",
          "items": {
            "enum": [
              "subprocess",
              "ci",
              "colab"
            ]
          }
        },
        "outputs": {
          "type": "object",
          "properties": {
            "checkpoint": {
              "type": "string"
            },
            "metrics": {
              "type": "string"
            }
          }
        },
        "script": {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "language": {
              "enum": [
                "python",
                "node",
                "shell"
              ]
            },
            "entrypoint": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object"
            }
          }
        },
        "notebook": {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "paramsCell": {
              "type": "integer"
            },
            "outputsCell": {
              "type": "string"
            }
          }
        },
        "adapter": {
          "type": "string"
        },
        "adapterOptions": {
          "type": "object"
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "recipe"
      ],
      "properties": {
        "recipe": {
          "enum": [
            "workflow",
            "script",
            "none"
          ]
        },
        "workflowRef": {
          "type": "string"
        },
        "script": {
          "type": "string",
          "description": "Module-owned build script (e.g. scripts/build-sherpa-kws.mjs); run by the generic workflow with inputs as env."
        },
        "fetchScript": {
          "type": "string"
        },
        "artifactName": {
          "type": "string"
        },
        "registryEntry": {
          "type": "string"
        },
        "fetch": {
          "type": "object",
          "description": "How scripts/fetch-artifact.mjs unpacks the artifact into assets/.",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "run",
                "release"
              ],
              "description": "Where the artifact comes from: a GitHub Actions run (default; build.artifactName) or a GitHub Release (source=release; static models with no CI build, e.g. openwakeword/hey-buddy)."
            },
            "releaseTag": {
              "type": "string",
              "description": "GitHub Release tag to download when source=release."
            },
            "pattern": {
              "type": "string",
              "description": "Glob for gh release download (default '*'). Use e.g. '*.tar.gz' for a layout-preserving archive."
            },
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "File whitelist (basenames); when set, only these files are copied, dropping demo extras (e.g. app.js, index.html)."
            },
            "subdir": {
              "type": "string",
              "description": "Subdirectory of assets/ to copy into (default: assets/ root)."
            }
          }
        },
        "toolchains": {
          "type": "object",
          "properties": {
            "emsdk": {
              "type": "string"
            },
            "python": {
              "type": "string"
            },
            "uv": {
              "type": "boolean"
            }
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "string",
                  "boolean",
                  "choice"
                ]
              },
              "default": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "l1": {
          "type": "string"
        },
        "l2": {
          "type": "string"
        },
        "l3": {
          "type": "string"
        },
        "required": {
          "type": "array",
          "items": {
            "enum": [
              "l1",
              "l2",
              "l3"
            ]
          }
        }
      }
    },
    "playground": {
      "type": "object",
      "required": [
        "route",
        "entry"
      ],
      "properties": {
        "route": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        }
      }
    },
    "interfaces": {
      "type": "object",
      "required": [
        "provides",
        "consumes"
      ],
      "properties": {
        "provides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "consumes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}