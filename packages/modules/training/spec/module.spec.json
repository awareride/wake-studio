{
  "$schema": "../../../contracts/src/module-spec.schema.json",
  "meta": {
    "id": "training",
    "name": "Training (custom wake-word)",
    "category": "training",
    "version": "0.1.0",
    "maturity": "draft",
    "owner": "WakeStudio team",
    "license": "MIT (integration)",
    "status": "proposed"
  },
  "params": [],
  "actions": [],
  "status": [],
  "runtime": {
    "web": {
      "engine": "TrainingJob"
    },
    "local": {
      "command": "node apps/studio-backend/src/server.ts",
      "protocol": "http"
    },
    "cloud": {
      "workflowRef": ".github/workflows/train-<module>.yml",
      "artifact": "trained-model"
    }
  },
  "tests": {
    "l1": "packages/modules/training/tests/manifest.test.ts",
    "required": [
      "l1"
    ]
  },
  "playground": {
    "route": "/playground/training",
    "entry": "packages/modules/training/web/playground.tsx"
  },
  "interfaces": {
    "provides": [
      "TrainingJob"
    ],
    "consumes": [
      "KWSBackend",
      "DataSources"
    ]
  }
}