{
  "$schema": "../../../contracts/src/module-spec.schema.json",
  "meta": {
    "id": "training",
    "name": "Training (custom wake-word)",
    "category": "training",
    "version": "0.1.0",
    "maturity": "draft",
    "owner": "WakeStudio team",
    "license": "MIT (integration)",
    "status": "proposed"
  },
  "params": [],
  "actions": [
    {
      "id": "train",
      "label": "Start training",
      "kind": "train",
      "progress": "indeterminate",
      "requires": []
    },
    {
      "id": "export",
      "label": "Export trained model",
      "kind": "export",
      "requires": []
    }
  ],
  "status": [
    {
      "id": "jobStatus",
      "label": "Training status",
      "renderer": "badge",
      "source": "event:jobStatus",
      "refreshMs": 1000
    },
    {
      "id": "progress",
      "label": "Training progress",
      "renderer": "bar",
      "source": "event:progress",
      "refreshMs": 250
    }
  ],
  "runtime": {
    "web": {
      "engine": "TrainingJob"
    },
    "local": {
      "command": "node apps/studio-backend/src/server.ts",
      "protocol": "http"
    },
    "cloud": {
      "workflowRef": ".github/workflows/train-<module>.yml",
      "artifact": "trained-model"
    }
  },
  "tests": {
    "l1": "packages/modules/training/tests/manifest.test.ts",
    "required": [
      "l1"
    ]
  },
  "playground": {
    "route": "/playground/training",
    "entry": "packages/modules/training/web/playground.tsx"
  },
  "interfaces": {
    "provides": [
      "TrainingJob"
    ],
    "consumes": [
      "KWSBackend",
      "DataSources"
    ]
  }
}