{
  "$schema": "../../../../contracts/src/module-spec.schema.json",
  "meta": {
    "id": "kws-sherpa",
    "name": "sherpa-onnx KWS (ASR-Decoding driver)",
    "category": "kws",
    "version": "0.1.0",
    "maturity": "draft",
    "owner": "WakeStudio team",
    "license": "Apache-2.0 (sherpa-onnx) + MIT (integration)",
    "status": "proposed"
  },
  "params": [
    {
      "id": "keywords",
      "label": "Wake words (comma-separated)",
      "group": "primary",
      "type": "string",
      "default": "n ǐ h ǎo j ūn g ē @你好军哥\nn ǐ h ǎo w èn w èn @你好问问\nx iǎo ài t óng x ué @小爱同学",
      "description": "Editable text wake-word list for ASR-Decoding KWS (ADR-024). One keyword per line: spaced tokens @label (sherpa-onnx text2token; the 2025-12-20 zh-en model uses ppinyin tokens + @display label, no score/threshold suffixes). Defaults match the model test keywords."
    },
    {
      "id": "threshold",
      "label": "Trigger threshold",
      "group": "primary",
      "type": "slider",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Detection threshold on the KWS posterior."
    }
  ],
  "actions": [
    {
      "id": "load",
      "label": "Load sherpa-onnx KWS",
      "kind": "load",
      "progress": "determinate",
      "requires": []
    },
    {
      "id": "start",
      "label": "Start detection",
      "kind": "start",
      "requires": [
        "platform.mic"
      ]
    },
    {
      "id": "stop",
      "label": "Stop detection",
      "kind": "stop"
    }
  ],
  "status": [
    {
      "id": "trigger",
      "label": "Trigger events",
      "renderer": "badge",
      "source": "event:trigger",
      "refreshMs": 500
    }
  ],
  "runtime": {
    "web": {
      "engine": "SherpaOnnxKwsBackend",
      "wasm": {
        "url": "/modules/kws/sherpa/assets/sherpa-onnx-kws/sherpa-onnx-wasm-kws-main.js",
        "loader": "emscripten"
      },
      "worker": true
    },
    "cloud": {
      "workflowRef": ".github/workflows/build.yaml",
      "artifact": "sherpa-onnx-kws-wasm"
    }
  },
  "build": {
    "recipe": "workflow",
    "workflowRef": ".github/workflows/build.yaml",
    "script": "scripts/build-sherpa-kws.mjs",
    "artifactName": "sherpa-onnx-kws-wasm",
    "registryEntry": "public/model-registry.json#kws-sherpa",
    "fetch": {
      "source": "release",
      "releaseTag": "models-sherpa-wasm-v1",
      "pattern": "*.tar.gz",
      "subdir": "sherpa-onnx-kws",
      "include": [
        "sherpa-onnx-wasm-kws-main.js",
        "sherpa-onnx-wasm-kws-main.wasm",
        "sherpa-onnx-wasm-kws-main.data",
        "sherpa-onnx-kws.js"
      ]
    },
    "toolchains": {
      "emsdk": "4.0.23"
    },
    "inputs": [
      {
        "id": "sherpa_version",
        "label": "sherpa-onnx ref (branch/tag; master has the single-threaded wasm fix dcf56735/#3836)",
        "type": "string",
        "default": "master",
        "required": false
      },
      {
        "id": "emsdk_version",
        "label": "emsdk (Emscripten) version",
        "type": "string",
        "default": "4.0.23",
        "required": false
      },
      {
        "id": "kws_model",
        "label": "KWS model archive",
        "type": "string",
        "default": "sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20.tar.bz2",
        "required": false
      }
    ],
    "notes": "The wasm runtime (built by scripts/build-sherpa-kws.mjs, ADR-027) is hosted as a GitHub Release and fetched via scripts/fetch-artifact.mjs; regenerate with the build script if a new build is required."
  },
  "tests": {
    "l1": "packages/modules/kws/sherpa/tests/spec.test.ts",
    "required": [
      "l1"
    ]
  },
  "playground": {
    "route": "/playground/kws/sherpa",
    "entry": "packages/modules/kws/sherpa/web/playground.tsx"
  },
  "interfaces": {
    "provides": [
      "KWSBackend"
    ],
    "consumes": [
      "AFEOutputFrame"
    ]
  }
}
