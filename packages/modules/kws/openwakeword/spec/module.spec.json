{
  "$schema": "../../../../contracts/src/module-spec.schema.json",
  "meta": {
    "id": "kws-openwakeword",
    "name": "OpenWakeWord KWS driver",
    "category": "kws",
    "version": "0.1.0",
    "maturity": "pilot",
    "owner": "WakeStudio team",
    "license": "Apache-2.0 (code); pre-trained models CC BY-NC-SA (demo-only)",
    "status": "accepted"
  },
  "params": [
    {
      "id": "threshold",
      "label": "Trigger threshold",
      "group": "primary",
      "type": "slider",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Smoothed posterior threshold."
    }
  ],
  "actions": [
    {
      "id": "load",
      "label": "Load OpenWakeWord models",
      "kind": "load",
      "progress": "determinate",
      "requires": []
    }
  ],
  "status": [
    {
      "id": "score",
      "label": "OpenWakeWord score",
      "renderer": "curve",
      "source": "event:score",
      "refreshMs": 100
    }
  ],
  "runtime": {
    "web": {
      "engine": "OpenWakeWordBackend",
      "worker": true
    }
  },
  "train": {
    "notebookLocal": "packages/modules/kws/openwakeword/train/colab/train.ipynb",
    "multiWord": false,
    "dataset": {
      "sampleRate": 16000,
      "minClipsPerLabel": 100,
      "needsNoise": true,
      "needsUnknowns": true,
      "labelMode": "single"
    },
    "invocation": [
      "studio-backend",
      "colab"
    ],
    "params": [
      {
        "id": "wakePhrase",
        "label": "Wake phrase",
        "group": "primary",
        "type": "string",
        "default": "hey studio",
        "description": "The wake phrase to train (notebook env WAKE_PHRASE). Spell phonetically with underscores if the default pronunciation is off, e.g. \"hey siri\" → \"hey_seer_e\".",
        "env": "WAKE_PHRASE"
      },
      {
        "id": "nSamples",
        "label": "Synthetic samples",
        "group": "advanced",
        "type": "number",
        "default": 1000,
        "min": 100,
        "max": 10000,
        "step": 100,
        "description": "Generated TTS sample count (notebook env WAKE_N_SAMPLES); raise for a stronger model.",
        "env": "WAKE_N_SAMPLES"
      },
      {
        "id": "steps",
        "label": "Training steps",
        "group": "advanced",
        "type": "number",
        "default": 10000,
        "min": 100,
        "max": 200000,
        "step": 1000,
        "description": "Optimizer steps (notebook env WAKE_STEPS); full models often use 50 000+.",
        "env": "WAKE_STEPS"
      },
      {
        "id": "falseActivationPenalty",
        "label": "False-activation penalty",
        "group": "advanced",
        "type": "number",
        "default": 1500,
        "min": 0,
        "max": 10000,
        "step": 100,
        "description": "max_negative_weight (notebook env WAKE_FALSE_ACTIVATION); higher = fewer false alarms.",
        "env": "WAKE_FALSE_ACTIVATION"
      },
      {
        "id": "augment",
        "label": "Audio augmentation",
        "group": "advanced",
        "type": "boolean",
        "default": true,
        "description": "Background mixing + room impulse responses (notebook env WAKE_AUGMENT).",
        "env": "WAKE_AUGMENT"
      }
    ],
    "outputs": {
      "checkpoint": "out/model.onnx",
      "metrics": "out/metrics.json"
    },
    "entry": "train/train_adapter.py",
    "formats": {
      "default": [
        "onnx"
      ],
      "options": [
        "onnx",
        "tflite-int8"
      ]
    },
    "quantization": {
      "default": "none",
      "options": [
        "none",
        "int8-static"
      ]
    },
    "convert": {
      "entry": "train/convert.py",
      "from": [
        "onnx"
      ],
      "to": [
        "onnx-fp16"
      ]
    }
  },
  "build": {
    "recipe": "none",
    "registryEntry": "public/model-registry.json#kws-openwakeword",
    "fetch": {
      "source": "release",
      "releaseTag": "models-openwakeword-v1",
      "pattern": "*.tar.gz"
    },
    "notes": "melspectrogram/embedding (Apache-2.0, upstream openWakeWord) + hey-buddy classifier (CC-BY-4.0) hosted as a GitHub Release (ADR-027 §6.7); fetched via scripts/fetch-artifact.mjs. The tar.gz preserves the module asset layout (openWakeWord/ + hey-buddy/models/)."
  },
  "tests": {
    "l1": "packages/modules/kws/openwakeword/tests/backend.test.ts",
    "required": [
      "l1"
    ]
  },
  "playground": {
    "route": "/playground/kws/openwakeword",
    "entry": "packages/modules/kws/openwakeword/web/playground.tsx"
  },
  "interfaces": {
    "provides": [
      "KWSBackend"
    ],
    "consumes": [
      "AFEOutputFrame"
    ]
  }
}
