{
  "$schema": "../../../../contracts/src/module-spec.schema.json",
  "meta": {
    "id": "kws-openwakeword",
    "name": "OpenWakeWord KWS driver",
    "category": "kws",
    "version": "0.1.0",
    "maturity": "pilot",
    "owner": "WakeStudio team",
    "license": "Apache-2.0 (code); pre-trained models CC BY-NC-SA (demo-only)",
    "status": "accepted"
  },
  "params": [
    {
      "id": "threshold",
      "label": "Trigger threshold",
      "group": "primary",
      "type": "slider",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "description": "Smoothed posterior threshold."
    }
  ],
  "actions": [
    {
      "id": "load",
      "label": "Load OpenWakeWord models",
      "kind": "load",
      "progress": "determinate",
      "requires": []
    }
  ],
  "status": [
    {
      "id": "score",
      "label": "OpenWakeWord score",
      "renderer": "curve",
      "source": "event:score",
      "refreshMs": 100
    }
  ],
  "runtime": {
    "web": {
      "engine": "OpenWakeWordBackend",
      "worker": true
    }
  },
  "build": {
    "recipe": "none",
    "registryEntry": "public/model-registry.json#kws-openwakeword",
    "fetch": {
      "source": "release",
      "releaseTag": "models-openwakeword-v1",
      "pattern": "*.tar.gz"
    },
    "notes": "melspectrogram/embedding (Apache-2.0, upstream openWakeWord) + hey-buddy classifier (CC-BY-4.0) hosted as a GitHub Release (ADR-027 §6.7); fetched via scripts/fetch-artifact.mjs. The tar.gz preserves the module asset layout (openWakeWord/ + hey-buddy/models/)."
  },
  "tests": {
    "l1": "packages/modules/kws/openwakeword/tests/backend.test.ts",
    "required": [
      "l1"
    ]
  },
  "playground": {
    "route": "/playground/kws/openwakeword",
    "entry": "packages/modules/kws/openwakeword/web/playground.tsx"
  },
  "interfaces": {
    "provides": [
      "KWSBackend"
    ],
    "consumes": [
      "AFEOutputFrame"
    ]
  }
}
