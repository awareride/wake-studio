{
  "$schema": "../../../../contracts/src/module-spec.schema.json",
  "meta": {
    "id": "kws-plix",
    "name": "PLiX Few-Shot encoder (driver)",
    "category": "kws",
    "version": "0.1.0",
    "maturity": "draft",
    "owner": "WakeStudio team",
    "license": "Apache-2.0 (plixkws) + MIT (integration)",
    "status": "proposed"
  },
  "params": [
    {
      "id": "encoder",
      "label": "PLiX encoder variant",
      "group": "primary",
      "type": "select",
      "default": "small",
      "options": [
        {
          "value": "base",
          "label": "PLiX base (EfficientNet-v2-M, 1280-d)"
        },
        {
          "value": "small",
          "label": "PLiX small (TinyNet-E, 1280-d)"
        }
      ],
      "description": "base = EfficientNet-v2-M (1280-d); small = TinyNet-E (lighter, low-RAM). Default is small (TinyNet-E) because only the small ONNX export is vendored in assets/; switch to base when you have the plixkws-base.onnx export."
    },
    {
      "id": "runtime",
      "label": "PLiX execution runtime",
      "group": "primary",
      "type": "select",
      "default": "onnx",
      "options": [
        {
          "value": "onnx",
          "label": "ONNX (onnxruntime-web)"
        },
        {
          "value": "transformers",
          "label": "Transformers.js (browser-native, CDN)"
        }
      ],
      "description": "onnx loads the exported ONNX graph; transformers runs the encoder browser-native via @huggingface/transformers (no ONNX file, zero-Python deployment)."
    }
  ],
  "actions": [
    {
      "id": "load",
      "label": "Load PLiX encoder",
      "kind": "load",
      "progress": "determinate",
      "requires": []
    }
  ],
  "status": [
    {
      "id": "embedDim",
      "label": "Embedding dim",
      "renderer": "badge",
      "source": "spec:const",
      "refreshMs": 1000
    }
  ],
  "runtime": {
    "web": {
      "engine": "PlixKwsEmbedProvider",
      "worker": true
    },
    "cloud": {
      "workflowRef": ".github/workflows/build.yaml",
      "artifact": "plixkws-onnx"
    }
  },
  "build": {
    "recipe": "workflow",
    "workflowRef": ".github/workflows/build.yaml",
    "script": "scripts/build-plix.mjs",
    "artifactName": "plixkws-onnx",
    "registryEntry": "public/model-registry.json#kws-plix",
    "toolchains": {
      "python": "3.11"
    },
    "inputs": [
      {
        "id": "encoder",
        "label": "PLiX encoder variant",
        "type": "choice",
        "default": "base",
        "required": true,
        "options": [
          "base",
          "small"
        ]
      },
      {
        "id": "language",
        "label": "Language tag for the .pt weights",
        "type": "string",
        "default": "en",
        "required": false
      },
      {
        "id": "opset",
        "label": "ONNX opset version (>= 18)",
        "type": "string",
        "default": "18",
        "required": false
      }
    ],
    "fetch": {
      "source": "release",
      "releaseTag": "models-plix-v1",
      "pattern": "*.tar.gz"
    },
    "notes": "The ONNX export (small variant, both flat + HF-style layouts) is hosted as a GitHub Release (ADR-027); fetched via scripts/fetch-artifact.mjs. Regenerate with scripts/build-plix.mjs (needs the .pt weights) if a new export is required."
  },
  "tests": {
    "l1": "packages/modules/kws/plix/tests/params.test.ts",
    "required": [
      "l1"
    ]
  },
  "playground": {
    "route": "/playground/kws/plix",
    "entry": "packages/modules/kws/plix/web/playground.tsx"
  },
  "interfaces": {
    "provides": [
      "EmbedProvider"
    ],
    "consumes": [
      "AFEOutputFrame"
    ]
  }
}
