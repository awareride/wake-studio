{
  "$schema": "../../../../contracts/src/module-spec.schema.json",
  "meta": {
    "id": "afe-bss",
    "name": "BSS stage (Blind Source Separation)",
    "category": "afe",
    "version": "0.1.0",
    "maturity": "draft",
    "owner": "WakeStudio team",
    "license": "MIT (integration)",
    "status": "proposed"
  },
  "params": [
    {
      "id": "bypass",
      "label": "Bypass BSS",
      "group": "primary",
      "type": "boolean",
      "default": true,
      "description": "Single-mic passthrough for v1 (ADR-016)."
    }
  ],
  "actions": [],
  "status": [
    {
      "id": "level",
      "label": "BSS level",
      "renderer": "bar",
      "source": "event:stageFrame",
      "refreshMs": 100
    }
  ],
  "runtime": {
    "web": { "engine": "BssStage" }
  },
  "tests": {
    "l1": "packages/modules/afe/bss/tests/stage.test.ts",
    "required": ["l1"]
  },
  "playground": {
    "route": "/playground/afe/bss",
    "entry": "packages/modules/afe/bss/web/playground.tsx"
  },
  "interfaces": {
    "provides": ["AFEStage"],
    "consumes": []
  }
}
