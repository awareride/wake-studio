{
  "$schema": "../../../../contracts/src/module-spec.schema.json",
  "meta": {
    "id": "edge-tts",
    "name": "Microsoft Edge TTS (classic)",
    "category": "data",
    "version": "0.1.0",
    "maturity": "draft",
    "owner": "WakeStudio team",
    "license": "MIT",
    "status": "proposed",
    "description": "TTS engine: multi-language edge-tts synthesis (classic-tts, backend). Its spec.params drive the Datasets generation wizard; the module owns its Python adapter (adapter.py) loaded by wake_train_kit.generation."
  },
  "params": [
    { "id": "languages", "label": "Languages", "group": "primary", "type": "string", "default": "en-US", "description": "Comma-separated BCP-47 language tags (e.g. en-US,zh-CN)." },
    { "id": "samplesPerPhrase", "label": "Samples per phrase", "group": "primary", "type": "number", "default": 3, "min": 1, "max": 20, "description": "How many synthesized clips per wake phrase." },
    { "id": "unknownWords", "label": "Unknown words (negatives)", "group": "advanced", "type": "string", "default": "goodbye,okay,stop,hello,thanks", "description": "Comma-separated negative words folded into _unknown_ by trainers." },
    { "id": "rate", "label": "Rate variation", "group": "advanced", "type": "string", "default": "", "description": "Optional TTS rate variation string (e.g. +10%, -5%)." },
    { "id": "pitch", "label": "Pitch variation", "group": "advanced", "type": "string", "default": "", "description": "Optional TTS pitch variation string (e.g. +5Hz)." }
  ],
  "actions": [],
  "status": [],
  "runtime": {
    "web": { "engine": "TTSEngine" }
  },
  "tts": {
    "kind": "classic-tts",
    "runtime": ["backend"],
    "provenanceTemplate": {
      "name": "edge-tts synthetic speech (multi-language)",
      "license": "user-owned (synthetic TTS)",
      "commercialUse": true,
      "source": "https://github.com/rany2/edge-tts"
    }
  },
  "tests": { "required": [] },
  "playground": { "route": "/playground/edge-tts", "entry": "none" },
  "interfaces": { "provides": ["TTSEngine"], "consumes": [] }
}
