{
  "id": "mimo-http",
  "name": "MiMo TTS (online HTTP, OpenAI-compatible)",
  "kind": "online-http-tts",
  "runtime": ["browser", "backend"],
  "params": {
    "endpoint": { "type": "string", "label": "API base URL", "default": "https://api.xiaomimimo.com/v1" },
    "apiKey": { "type": "secret", "label": "API key", "required": true },
    "model": { "type": "string", "label": "Model", "default": "mimo-v2.5-tts" },
    "voice": { "type": "string", "label": "Preset voice", "default": "" },
    "styleInstruction": { "type": "string", "label": "Style instruction (natural language)", "default": "" },
    "languages": { "type": "string[]", "label": "Languages", "default": ["en-US"] },
    "samplesPerPhrase": { "type": "number", "label": "Samples per phrase", "default": 3 },
    "outputFormat": { "type": "string", "label": "Output audio format", "default": "pcm16" }
  },
  "provenanceTemplate": {
    "name": "MiMo TTS (online API) synthetic speech",
    "license": "user-owned (synthetic TTS)",
    "commercialUse": true,
    "source": "https://mimo.mi.com/docs/zh-CN/quick-start/usage-guide/audio/speech-synthesis-v2.5"
  }
}
