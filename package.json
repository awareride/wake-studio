{
  "name": "wake-studio",
  "version": "0.0.1",
  "private": true,
  "description": "WakeStudio monorepo - a PWA console + optional studio-backend + device SDK for on-device wake-word (KWS) pipelines. AEC -> BSS -> NS -> KWS.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @wake-studio/web build",
    "dev": "pnpm --filter @wake-studio/web dev",
    "dev:service": "uv run --project apps/studio-backend wake-service",
    "fetch:all": "pnpm -r fetch:all",
    "gen:wires": "node scripts/gen-module-wires.mjs --update",
    "gen:wires:check": "node scripts/gen-module-wires.mjs --check",
    "gen:registry": "node scripts/build-model-registry.mjs --update",
    "gen:registry:check": "node scripts/build-model-registry.mjs --check",
    "lint": "pnpm -r lint",
    "preview": "pnpm --filter @wake-studio/web preview",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "pnpm --filter @wake-studio/web test:e2e",
    "test:unit": "pnpm -r test:unit",
    "typecheck": "pnpm -r typecheck",
    "gen:engines": "node scripts/build-dataset-engines.mjs --update",
    "gen:engines:check": "node scripts/build-dataset-engines.mjs --check"
  },
  "devDependencies": {
    "typescript": "~5.6.3"
  }
}
