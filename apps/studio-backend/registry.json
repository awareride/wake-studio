{
 "kws-openwakeword": {
  "cwd": "../../packages/modules/kws/openwakeword/train",
  "engine": "direct",
  "entry": "train_adapter.py",
  "env": {
   "UPSTREAM_PYTHON": "{env.UPSTREAM_PYTHON}",
   "WAKE_AUGMENT": "{params.augment}",
   "WAKE_BACKEND": "self-hosted",
   "WAKE_DATASETS": "{params.datasets}",
   "WAKE_FALSE_ACTIVATION": "{params.falseActivationPenalty}",
   "WAKE_FORMATS": "{params.formats}",
   "WAKE_N_SAMPLES": "{params.nSamples}",
   "WAKE_PHRASE": "{params.wakePhrase}",
   "WAKE_QUANTIZATION": "{params.quantization}",
   "WAKE_QUANTIZE": "{params.quantize}",
   "WAKE_STEPS": "{params.steps}"
  }
 },
 "kws-streaming": {
  "cwd": "../../packages/modules/kws/streaming/train",
  "engine": "uv",
  "extras": [
   "tf",
   "tts"
  ],
  "entry": "train_adapter.py",
  "env": {
   "STREAM_BACKEND": "self-hosted",
   "STREAM_DATASETS": "{params.datasets}",
   "STREAM_FEATURE_TYPE": "{params.featureType}",
   "STREAM_FORMATS": "{params.formats}",
   "STREAM_HOW_MANY_TRAINING_STEPS": "{params.howManyTrainingSteps}",
   "STREAM_LEARNING_RATE": "{params.learningRate}",
   "STREAM_MODEL": "{params.model}",
   "STREAM_PREPROCESS": "{params.preprocess}",
   "STREAM_QUANTIZATION": "{params.quantization}",
   "STREAM_SPLIT_DATA": "{params.splitData}",
   "STREAM_WANTED_WORDS": "{params.wantedWords}",
   "UPSTREAM_PYTHON": "{env.UPSTREAM_PYTHON}"
  },
  "stage": {
   "paths": [
    "packages/modules/kws/streaming/train",
    "third_party/kws_streaming"
   ],
   "cwd": "packages/modules/kws/streaming/train",
   "env": {
    "UPSTREAM_DIR": "third_party"
   }
  }
 },
 "dry-run": {
  "cwd": "../../packages/modules/dry-run/train",
  "engine": "direct",
  "entry": "dry_run.py",
  "env": {
   "WAKE_PHRASE": "{params.wakePhrase}",
   "WAKE_STEPS": "{params.steps}",
   "WAKE_BACKEND": "self-hosted"
  },
  "stage": {
   "paths": [
    "packages/modules/dry-run/train"
   ],
   "cwd": "packages/modules/dry-run/train",
   "env": {}
  }
 },
 "dataset-generate": {
  "cwd": "src/wake_train_kit",
  "engine": "direct",
  "entry": "generation_runner.py",
  "env": {
   "GEN_ENGINE": "{params.engine}",
   "GEN_PHRASES": "{params.phrases}",
   "GEN_LANGUAGES": "{params.languages}",
   "GEN_SAMPLES": "{params.samplesPerPhrase}",
   "GEN_UNKNOWN_WORDS": "{params.unknownWords}",
   "GEN_POSTPROCESS": "{params.postprocess}",
   "GEN_ENDPOINT": "{params.endpoint}",
   "GEN_API_KEY": "{params.apiKey}",
   "GEN_MODEL": "{params.model}",
   "GEN_VOICE": "{params.voice}",
   "GEN_STYLE": "{params.styleInstruction}",
   "GEN_SAMPLE_RATE": "{params.sampleRate}",
   "GEN_NAME": "{params.name}",
   "GEN_DATASET_ID": "{params.datasetId}",
   "GEN_SEED": "{params.seed}",
   "GEN_BACKEND": "self-hosted"
  }
 },
 "dataset-storage": {
  "cwd": "src/wake_train_kit",
  "engine": "direct",
  "entry": "storage_runner.py",
  "env": {
   "STORAGE_ACTION": "{params.action}",
   "STORAGE_BACKEND": "{params.backend}",
   "STORAGE_SRC": "{params.src}",
   "STORAGE_DEST": "{params.dest}",
   "STORAGE_PREFIX": "{params.prefix}",
   "GEN_BACKEND": "self-hosted"
  }
 },
 "dataset-check": {
  "cwd": "src/wake_train_kit",
  "engine": "direct",
  "entry": "check_runner.py",
  "env": {
   "CHECK_DATASET_ID": "{params.datasetId}",
   "CHECK_SRC": "{params.src}",
   "GEN_BACKEND": "self-hosted"
  }
 },
 "dataset-split": {
  "cwd": "src/wake_train_kit",
  "engine": "direct",
  "entry": "split_runner.py",
  "env": {
   "SPLIT_DATASET_ID": "{params.datasetId}",
   "SPLIT_SRC": "{params.src}",
   "SPLIT_SEED": "{params.seed}",
   "SPLIT_RATIOS": "{params.ratios}",
   "GEN_BACKEND": "self-hosted"
  }
 }
}
