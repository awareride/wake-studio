{
  "kws-openwakeword": {
    "cwd": "../../packages/modules/kws/openwakeword/train",
    "engine": "direct",
    "entry": "train_adapter.py",
    "env": {
      "WAKE_PHRASE": "{params.wakePhrase}",
      "WAKE_N_SAMPLES": "{params.nSamples}",
      "WAKE_STEPS": "{params.steps}",
      "WAKE_FALSE_ACTIVATION": "{params.falseActivationPenalty}",
      "WAKE_AUGMENT": "{params.augment}",
      "WAKE_QUANTIZE": "{params.quantize}",
      "WAKE_BACKEND": "self-hosted",
      "UPSTREAM_PYTHON": "{env.UPSTREAM_PYTHON}"
    }
  },
  "dry-run": {
    "cwd": "../../packages/modules/dry-run/train",
    "engine": "direct",
    "entry": "dry_run.py",
    "env": {
      "WAKE_PHRASE": "{params.wakePhrase}",
      "WAKE_STEPS": "{params.steps}",
      "WAKE_BACKEND": "self-hosted"
    }
  },
  "dataset-storage": {
    "cwd": "src/wake_train_kit",
    "engine": "direct",
    "entry": "storage_runner.py",
    "env": {
      "STORAGE_ACTION": "{params.action}",
      "STORAGE_BACKEND": "{params.backend}",
      "STORAGE_SRC": "{params.src}",
      "STORAGE_DEST": "{params.dest}",
      "STORAGE_PREFIX": "{params.prefix}",
      "GEN_BACKEND": "self-hosted"
    }
  }
}
