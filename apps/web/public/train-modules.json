{
  "$schema": "./train-modules.schema.json",
  "version": 1,
  "updated": "2026-08-13",
  "note": "Catalog of trainable modules (spec.train, issue #105). Generated from the module specs - the single shared fact source (ADR-025). The training console picks the model type (openwakeword / streaming / rnnoise), renders its train config, and offers the invocation methods the module declares.",
  "modules": [
    {
      "id": "rnnoise",
      "category": "afe",
      "name": "RNNoise Noise Suppression",
      "license": "BSD-3-Clause (RNNoise) + MIT (integration)",
      "maturity": "pilot",
      "train": {
        "entry": "train/train.py",
        "python": "3.11",
        "deps": "train/pyproject.toml",
        "invocation": [
          "ci"
        ],
        "outputs": {
          "checkpoint": "out/rnnoise.onnx",
          "metrics": "out/metrics.json"
        }
      }
    },
    {
      "id": "kws-openwakeword",
      "category": "kws",
      "name": "OpenWakeWord KWS driver",
      "license": "Apache-2.0 (code); pre-trained models CC BY-NC-SA (demo-only)",
      "maturity": "pilot",
      "train": {
        "notebookLocal": "packages/modules/kws/openwakeword/train/colab/train.ipynb",
        "invocation": [
          "colab"
        ],
        "outputs": {
          "checkpoint": "out/model.onnx",
          "metrics": "out/metrics.json"
        }
      }
    },
    {
      "id": "kws-streaming",
      "category": "kws",
      "name": "kws_streaming (Traditional streaming-aware driver)",
      "license": "Apache-2.0 (google-research/kws_streaming + ARM keyword-transformer) + MIT (integration)",
      "maturity": "pilot",
      "train": {
        "script": {
          "repo": "https://github.com/google-research/google-research",
          "path": "kws_streaming/train/model_train_eval.py",
          "ref": "master",
          "language": "python",
          "entrypoint": "python -m kws_streaming.train.model_train_eval",
          "args": [
            "--data_dir",
            "--wanted_words",
            "--train_dir",
            "--split_data",
            "--preprocess",
            "--feature_type",
            "--how_many_training_steps",
            "--learning_rate",
            "--train"
          ]
        },
        "invocation": [
          "subprocess",
          "ci",
          "colab"
        ],
        "outputs": {
          "checkpoint": "tflite_stream_state_external/stream_state_external.tflite",
          "metrics": "tflite_stream_state_external/tflite_stream_state_external_model_accuracy_reset0.txt"
        },
        "adapter": "standardize-results",
        "adapterOptions": {
          "modelRegex": "stream_state_external\\.tflite$",
          "labelsFile": "labels.txt",
          "flagsFile": "flags.json"
        }
      }
    }
  ]
}
