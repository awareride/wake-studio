{
  "$schema": "./train-modules.schema.json",
  "version": 1,
  "updated": "2026-08-18",
  "note": "Catalog of trainable modules (spec.train, issue #105). Generated from the module specs - the single shared fact source (ADR-025). The training console picks the model type (openwakeword / streaming / rnnoise), renders its train config, and offers the invocation methods the module declares.",
  "modules": [
    {
      "id": "rnnoise",
      "category": "afe",
      "name": "RNNoise Noise Suppression",
      "license": "BSD-3-Clause (RNNoise) + MIT (integration)",
      "maturity": "pilot",
      "train": {
        "entry": "train/train.py",
        "python": "3.11",
        "deps": "train/pyproject.toml",
        "invocation": [
          "ci"
        ],
        "outputs": {
          "checkpoint": "out/rnnoise.onnx",
          "metrics": "out/metrics.json"
        }
      }
    },
    {
      "id": "dry-run",
      "category": "dry-run",
      "name": "Dry-run (demo)",
      "license": "MIT",
      "maturity": "demo",
      "train": {
        "entry": "train/dry_run.py",
        "deps": "pyproject.toml",
        "invocation": [
          "studio-backend"
        ],
        "params": [
          {
            "id": "wakePhrase",
            "label": "Wake phrase",
            "group": "primary",
            "type": "string",
            "default": "hey studio",
            "description": "The (fake) wake phrase to train (env WAKE_PHRASE).",
            "env": "WAKE_PHRASE"
          },
          {
            "id": "steps",
            "label": "Steps (fake)",
            "group": "advanced",
            "type": "number",
            "default": 5,
            "min": 1,
            "max": 50,
            "step": 1,
            "description": "How many fake progress steps to emit (env WAKE_STEPS); keep small — it is a demo.",
            "env": "WAKE_STEPS"
          }
        ]
      }
    },
    {
      "id": "kws-openwakeword",
      "category": "kws",
      "name": "OpenWakeWord KWS driver",
      "license": "Apache-2.0 (code); pre-trained models CC BY-NC-SA (demo-only)",
      "maturity": "pilot",
      "train": {
        "notebookLocal": "packages/modules/kws/openwakeword/train/colab/train.ipynb",
        "multiWord": false,
        "invocation": [
          "studio-backend",
          "colab"
        ],
        "params": [
          {
            "id": "wakePhrase",
            "label": "Wake phrase",
            "group": "primary",
            "type": "string",
            "default": "hey studio",
            "description": "The wake phrase to train (notebook env WAKE_PHRASE). Spell phonetically with underscores if the default pronunciation is off, e.g. \"hey siri\" → \"hey_seer_e\".",
            "env": "WAKE_PHRASE"
          },
          {
            "id": "nSamples",
            "label": "Synthetic samples",
            "group": "advanced",
            "type": "number",
            "default": 1000,
            "min": 100,
            "max": 10000,
            "step": 100,
            "description": "Generated TTS sample count (notebook env WAKE_N_SAMPLES); raise for a stronger model.",
            "env": "WAKE_N_SAMPLES"
          },
          {
            "id": "steps",
            "label": "Training steps",
            "group": "advanced",
            "type": "number",
            "default": 10000,
            "min": 100,
            "max": 200000,
            "step": 1000,
            "description": "Optimizer steps (notebook env WAKE_STEPS); full models often use 50 000+.",
            "env": "WAKE_STEPS"
          },
          {
            "id": "falseActivationPenalty",
            "label": "False-activation penalty",
            "group": "advanced",
            "type": "number",
            "default": 1500,
            "min": 0,
            "max": 10000,
            "step": 100,
            "description": "max_negative_weight (notebook env WAKE_FALSE_ACTIVATION); higher = fewer false alarms.",
            "env": "WAKE_FALSE_ACTIVATION"
          },
          {
            "id": "augment",
            "label": "Audio augmentation",
            "group": "advanced",
            "type": "boolean",
            "default": true,
            "description": "Background mixing + room impulse responses (notebook env WAKE_AUGMENT).",
            "env": "WAKE_AUGMENT"
          }
        ],
        "outputs": {
          "checkpoint": "out/model.onnx",
          "metrics": "out/metrics.json"
        },
        "entry": "train/train_adapter.py",
        "formats": {
          "default": [
            "onnx"
          ],
          "options": [
            "onnx",
            "tflite-int8"
          ]
        },
        "quantization": {
          "default": "none",
          "options": [
            "none",
            "int8-static"
          ]
        },
        "convert": {
          "entry": "train/convert.py",
          "from": [
            "onnx"
          ],
          "to": [
            "onnx-fp16"
          ]
        }
      }
    },
    {
      "id": "kws-streaming",
      "category": "kws",
      "name": "kws_streaming (Traditional streaming-aware driver)",
      "license": "Apache-2.0 (google-research/kws_streaming + ARM keyword-transformer) + MIT (integration)",
      "maturity": "pilot",
      "train": {
        "entry": "train/train_adapter.py",
        "script": {
          "repo": "https://github.com/google-research/google-research",
          "path": "kws_streaming/train/model_train_eval.py",
          "ref": "cf61877d4c0021ff40ec3ecc0334aaa3937a1fcb",
          "language": "python",
          "entrypoint": "python -m kws_streaming.train.model_train_eval",
          "args": [
            "--data_dir",
            "--wanted_words",
            "--train_dir",
            "--split_data",
            "--preprocess",
            "--feature_type",
            "--how_many_training_steps",
            "--learning_rate",
            "--train"
          ]
        },
        "invocation": [
          "studio-backend",
          "ci"
        ],
        "multiWord": true,
        "params": [
          {
            "id": "model",
            "label": "Model topology",
            "group": "primary",
            "type": "select",
            "default": "ds_tc_resnet",
            "options": [
              "ds_tc_resnet",
              "bc_resnet",
              "cnn",
              "ds_cnn",
              "svdf",
              "svdf_resnet",
              "crnn",
              "dnn",
              "gru",
              "lstm",
              "dnn_raw"
            ],
            "description": "Upstream model topology (positional arg). Only streamable topologies are listed; non-streamable ones (att_*, tc_resnet, mobilenet*, xception, inception*) cannot be converted to external-state streaming."
          },
          {
            "id": "wantedWords",
            "label": "Wake word(s)",
            "group": "primary",
            "type": "string",
            "default": "yes",
            "description": "Comma-separated label folders to train as the wake word (upstream --wanted_words). All other labels fold into _unknown_. For the edge-tts data source this is derived from wakePhrases."
          },
          {
            "id": "dataSource",
            "label": "Data source",
            "group": "primary",
            "type": "select",
            "default": "speech-commands-v2",
            "options": [
              "speech-commands-v2",
              "user-url",
              "edge-tts",
              "local-dir",
              "mixed"
            ],
            "description": "speech-commands-v2 = Google Speech Commands V2 (CC BY 4.0); user-url = a user-provided dataset archive URL; edge-tts = multi-language TTS synthesis; local-dir = a pre-prepared label/*.wav tree; mixed = merge positiveSource (wake word) with negativeSource (real speech / noise -> _unknown_)."
          },
          {
            "id": "positiveSource",
            "label": "Positive source (wake word)",
            "group": "primary",
            "type": "select",
            "default": "edge-tts",
            "options": [
              "edge-tts",
              "user-url"
            ],
            "description": "For dataSource=mixed: the source whose label folders are trained as the wake word (land in --wanted_words). edge-tts uses wakePhrases/ttsLanguages/ttsSamples; user-url uses dataUrl."
          },
          {
            "id": "negativeSource",
            "label": "Negative source (unknowns + noise)",
            "group": "primary",
            "type": "select",
            "default": "speech-commands-v2",
            "options": [
              "speech-commands-v2",
              "user-url",
              "none"
            ],
            "description": "For dataSource=mixed: the source providing real-speech unknowns (fold into _unknown_) and real _background_noise_. none = synthesize silence only."
          },
          {
            "id": "dataUrl",
            "label": "Dataset archive URL",
            "group": "advanced",
            "type": "string",
            "default": "",
            "description": "Required when dataSource is user-url. .tar.gz/.tgz/.tar/.zip of a label/*.wav tree."
          },
          {
            "id": "wakePhrases",
            "label": "Wake phrases (TTS)",
            "group": "advanced",
            "type": "string",
            "default": "hey studio",
            "description": "Comma-separated wake phrases to synthesize when dataSource is edge-tts. Folder name = phrase with spaces -> underscores."
          },
          {
            "id": "ttsLanguages",
            "label": "TTS languages",
            "group": "advanced",
            "type": "string",
            "default": "en-US",
            "description": "Comma-separated language codes for edge-tts voices (e.g. en-US,zh-CN,ja-JP)."
          },
          {
            "id": "ttsSamples",
            "label": "TTS samples per phrase",
            "group": "advanced",
            "type": "number",
            "default": 3,
            "min": 1,
            "max": 50,
            "step": 1,
            "description": "Clips per wake phrase per language when dataSource is edge-tts."
          },
          {
            "id": "featureType",
            "label": "Feature type",
            "group": "primary",
            "type": "select",
            "default": "mfcc_op",
            "options": [
              "mfcc_op",
              "mfcc_tf"
            ],
            "description": "Input features (upstream --feature_type). 'mfcc_op' keeps the feature extractor FFT-based inside the graph (the recommended raw-preprocess export)."
          },
          {
            "id": "howManyTrainingSteps",
            "label": "Training steps",
            "group": "advanced",
            "type": "string",
            "default": "10000,10000,10000",
            "description": "Upstream --how_many_training_steps (comma-separated staged schedule)."
          },
          {
            "id": "learningRate",
            "label": "Learning rate",
            "group": "advanced",
            "type": "string",
            "default": "0.0005,0.0001,0.00002",
            "description": "Upstream --learning_rate (comma-separated, paired with the staged steps)."
          }
        ],
        "outputs": {
          "checkpoint": "tflite_stream_state_external/stream_state_external.tflite",
          "metrics": "tflite_stream_state_external/tflite_stream_state_external_model_accuracy_reset0.txt"
        },
        "adapter": "standardize-results",
        "adapterOptions": {
          "modelRegex": "stream_state_external\\.tflite$",
          "labelsFile": "labels.txt",
          "flagsFile": "flags.json"
        },
        "formats": {
          "default": [
            "tflite"
          ],
          "options": [
            "tflite",
            "onnx"
          ]
        },
        "quantization": {
          "default": "none",
          "options": [
            "none"
          ]
        },
        "convert": {
          "entry": "train/convert.py",
          "from": [
            "tflite"
          ],
          "to": [
            "onnx"
          ]
        }
      }
    }
  ]
}
