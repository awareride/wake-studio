.vscode/
.idea/
*.swp
*.swo
*~

# Build / cache
.cache/
dist/
build/
.packscope-cache/
.astro/

# Local environment
.env
.env.local

# Archive (old static site)
_archive/
.wrangler/

# Lockfiles (pnpm is canonical; ignore npm/yarn)
package-lock.json

# TypeScript build info
*.tsbuildinfo
node_modules/.tmp/

# Playwright
playwright-report/
test-results/

# Agents
.agents/

# Module-owned binary assets (ADR-025). Built in CI (ADR-027), fetched locally,
# never committed (ADR-011).
packages/modules/*/*/assets/*
!packages/modules/*/*/assets/README.md

# uv train environments + runtime outputs (ADR-028)
packages/modules/*/*/train/.venv/
packages/modules/*/*/train/out/
packages/modules/*/*/train/*.egg-info/

# onnxruntime-web wasm runtime (copied from node_modules at build, P0-4)
apps/web/public/ort/

# studio-backend runtime state (ADR-036): SQLite store + artifacts
apps/studio-backend/.venv/
apps/studio-backend/data/
apps/studio-backend/.pytest_cache/
**/__pycache__/
apps/studio-backend/*.egg-info/

# repo-root studio-backend runtime state (default --db/--artifacts-dir paths)
data/

# standard artifact bundle output (docs/modules/training.md §6)
**/wake-studio-results/
apps/studio-backend/src/wake_training_service/_revision.py
